# ملف بيئة التطوير - مُدرج في assets للوصول من التطبيق
# في الإنتاج، استبدل هذه القيم بقيم حقيقية

API_BASE_URL=https://api.example.com/v1
API_KEY=dev_api_key_placeholder
API_TIMEOUT_SECONDS=30

HIVE_BOX_NAME=app_cache
CACHE_TTL_HOURS=24

APP_NAME=تطبيقي
APP_BUNDLE_ID=com.example.flutter_template
APP_VERSION=1.0.0

DEEP_LINK_SCHEME=myapp
DEEP_LINK_HOST=app.example.com

IMAGE_PLACEHOLDER_URL=https://via.placeholder.com/300

APP_ENV=development

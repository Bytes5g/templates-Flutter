# مثال على ملف البيئة - انسخ هذا الملف إلى .env وعدّل القيم
# Example environment file - copy to .env and update values

API_BASE_URL=https://api.example.com
API_KEY=your_api_key_here
API_TIMEOUT=30000
APP_NAME=Flutter Template
APP_VERSION=1.0.0
APP_ENV=development
CACHE_MAX_AGE=3600
CACHE_MAX_STALE=86400
IMAGE_CDN_URL=https://cdn.example.com
IMAGE_MAX_WIDTH=1080
IMAGE_QUALITY=85

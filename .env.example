# ملف بيئة التطوير - لا يُرفع لـ Git
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك

# عنوان API الأساسي
API_BASE_URL=https://api.example.com/v1

# مفاتيح واجهات برمجة التطبيقات
API_KEY=your_api_key_here
API_TIMEOUT_SECONDS=30

# إعدادات التخزين المحلي
HIVE_BOX_NAME=app_cache
CACHE_TTL_HOURS=24

# إعدادات التطبيق
APP_NAME=اسم التطبيق
APP_BUNDLE_ID=com.example.flutter_template
APP_VERSION=1.0.0

# روابط التطبيق العميقة
DEEP_LINK_SCHEME=myapp
DEEP_LINK_HOST=app.example.com

# إعدادات الصور
IMAGE_PLACEHOLDER_URL=https://via.placeholder.com/300

# بيئة التشغيل: development | staging | production
APP_ENV=development
